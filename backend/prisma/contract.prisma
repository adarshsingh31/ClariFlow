// use prisma-8

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  orders      Order[]
}

model Order {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  customerName String
  status       String
  totalAmount  Float
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  productId    Int?
  product      Product? @relation(fields: [productId], references: [id])
}